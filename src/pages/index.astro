---
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Press+Start+2P&display=swap" rel="stylesheet" />
		<title>Mona Mayhem</title>
	</head>
	<body>
		<main class="page">
			<header class="page-header">
				<h1>Mona Mayhem</h1>
				<p>GitHub Contribution Battle Arena</p>
				<button id="sfx-toggle" class="sfx-toggle" type="button" aria-pressed="true" aria-label="Mute sound effects">
					🔊 SFX: ON
				</button>
			</header>

			<section class="power-bars" id="power-bars" aria-label="Battle power bars" hidden>
				<div class="power-player player-one-power">
					<span id="power-one-name">Player 1</span>
					<div class="power-track" role="progressbar" id="power-one" aria-label="Player 1 power" aria-valuemin="0" aria-valuemax="5" aria-valuenow="0">
						<span class="power-fill" id="power-one-fill"></span>
					</div>
				</div>
				<span class="power-versus" aria-hidden="true">VS</span>
				<div class="power-player player-two-power">
					<span id="power-two-name">Player 2</span>
					<div class="power-track" role="progressbar" id="power-two" aria-label="Player 2 power" aria-valuemin="0" aria-valuemax="5" aria-valuenow="0">
						<span class="power-fill" id="power-two-fill"></span>
					</div>
				</div>
			</section>

			<form class="battle-form" id="battle-form" aria-label="Choose battle players" novalidate>
				<div class="field">
					<label for="player-one">Player 1</label>
					<input id="player-one" name="playerOne" type="text" placeholder="GitHub username" minlength="1" maxlength="39" autocomplete="off" required />
				</div>
				<span class="versus" aria-hidden="true">VS</span>
				<div class="field">
					<label for="player-two">Player 2</label>
					<input id="player-two" name="playerTwo" type="text" placeholder="GitHub username" minlength="1" maxlength="39" autocomplete="off" required />
				</div>
				<button id="battle-button" type="submit">BATTLE!</button>
			</form>
			<nav class="preset-matchups" aria-label="Quick matchups">
				<span>QUICK MATCH:</span>
				<button type="button" class="preset-button" data-player-one="torvalds" data-player-two="gaearon">
					torvalds vs. gaearon
				</button>
				<button type="button" class="preset-button" data-player-one="octocat" data-player-two="sindresorhus">
					octocat vs. sindresorhus
				</button>
			</nav>

			<div class="status" aria-live="polite" aria-atomic="true">
				<p id="status-message">Enter two usernames and start a battle.</p>
				<p id="error-message" class="error" role="alert" hidden></p>
			</div>
			<div class="battle-clash" id="battle-clash" role="status" aria-live="assertive" hidden></div>

			<section class="scoreboard" id="scoreboard" aria-labelledby="scoreboard-title" hidden>
				<h2 id="scoreboard-title">Battle Scoreboard</h2>
				<p id="winner-banner" class="winner-banner" aria-live="polite"></p>
				<p id="battle-score"></p>
				<div class="table-wrap">
					<table class="score-table">
						<thead>
							<tr>
								<th scope="col">Category</th>
								<th scope="col" id="score-player-one">Player 1</th>
								<th scope="col">Battle points</th>
								<th scope="col" id="score-player-two">Player 2</th>
							</tr>
						</thead>
						<tbody id="score-rows"></tbody>
					</table>
				</div>
			</section>

			<section class="arena" id="arena" aria-label="Player arenas" hidden>
				<article class="player-card" aria-labelledby="player-one-title">
					<header class="card-header">
						<a class="profile-link" id="profile-one" target="_blank" rel="noopener noreferrer" aria-label="Open Player 1 GitHub profile">
							<img class="avatar-placeholder" id="avatar-one" alt="" width="48" height="48" />
						</a>
						<div class="player-info">
							<h2 id="player-one-title">Player 1</h2>
							<p class="fighter-class" id="fighter-one-class"></p>
							<p id="player-one-date"></p>
						</div>
					</header>
					<section class="contributions" aria-labelledby="player-one-grid-title">
						<h3 id="player-one-grid-title">52-week contribution grid</h3>
						<div class="grid-placeholder" id="grid-one" role="group" aria-label="Player 1 contribution calendar"></div>
					</section>
					<section class="stats" aria-label="Player 1 summary statistics">
						<h3>Summary stats</h3>
						<dl class="stats-list" id="stats-one"></dl>
					</section>
				</article>

				<article class="player-card" aria-labelledby="player-two-title">
					<header class="card-header">
						<a class="profile-link" id="profile-two" target="_blank" rel="noopener noreferrer" aria-label="Open Player 2 GitHub profile">
							<img class="avatar-placeholder" id="avatar-two" alt="" width="48" height="48" />
						</a>
						<div class="player-info">
							<h2 id="player-two-title">Player 2</h2>
							<p class="fighter-class" id="fighter-two-class"></p>
							<p id="player-two-date"></p>
						</div>
					</header>
					<section class="contributions" aria-labelledby="player-two-grid-title">
						<h3 id="player-two-grid-title">52-week contribution grid</h3>
						<div class="grid-placeholder" id="grid-two" role="group" aria-label="Player 2 contribution calendar"></div>
					</section>
					<section class="stats" aria-label="Player 2 summary statistics">
						<h3>Summary stats</h3>
						<dl class="stats-list" id="stats-two"></dl>
					</section>
				</article>
			</section>
		</main>
	</body>
</html>

<script>
	import { calculateStats, getContributionDays, parseContributionResponse, assignFighterClass } from '../lib/contributions.js';
	import { scoreBattle } from '../lib/battle.js';
	import { isSfxEnabled, playCoin, playHit, playPowerUp, playVictory, setSfxEnabled } from '../lib/arcade-sfx.js';
	import { isValidGitHubUsername } from '../lib/github-username.js';

	const form = document.querySelector('.battle-form');
	const playerOneInput = document.querySelector('#player-one');
	const playerTwoInput = document.querySelector('#player-two');
	const battleButton = document.querySelector('#battle-button');
	const sfxToggle = document.querySelector('#sfx-toggle');
	const statusMessage = document.querySelector('#status-message');
	const errorMessage = document.querySelector('#error-message');
	const scoreboard = document.querySelector('#scoreboard');
	const arena = document.querySelector('#arena');
	const battleClash = document.querySelector('#battle-clash');
	const powerBars = document.querySelector('#power-bars');
	const presetButtons = document.querySelectorAll('.preset-button');
	let requestVersion = 0;

	function delay(milliseconds) {
		return new Promise((resolve) => window.setTimeout(resolve, milliseconds));
	}

	function formatNumber(value) {
		return new Intl.NumberFormat().format(value);
	}

	async function getPlayer(username) {
		const response = await fetch(`/api/contributions/${encodeURIComponent(username)}`);
		const data = await response.json().catch(() => null);
		if (!response.ok) {
			const message = data && typeof data.error === 'string'
				? data.error
				: response.status === 404
					? `GitHub user "${username}" was not found.`
					: `Could not load contributions for "${username}".`;
			throw new Error(message);
		}

		return parseContributionResponse(data, username);
	}

	function setText(selector, value) {
		document.querySelector(selector).textContent = value;
	}

	function setPower(position, points) {
		const suffix = position === 1 ? 'one' : 'two';
		const track = document.querySelector(`#power-${suffix}`);
		track.setAttribute('aria-valuenow', String(points));
		document.querySelector(`#power-${suffix}-fill`).style.width = `${(points / 5) * 100}%`;
	}

	async function runCountdown(version) {
		for (const message of ['VS', '3…', '2…', '1…', 'FIGHT!']) {
			if (version !== requestVersion) return;
			battleClash.textContent = message;
			await delay(250);
		}
	}

	function triggerVictoryEffect() {
		const winnerBanner = document.querySelector('#winner-banner');
		winnerBanner.classList.remove('victory-animation');
		void winnerBanner.offsetWidth;
		winnerBanner.classList.add('victory-animation');
		document.body.classList.remove('screen-shake');
		void document.body.offsetWidth;
		document.body.classList.add('screen-shake');
		const particles = document.createElement('div');
		particles.className = 'victory-particles';
		particles.setAttribute('aria-hidden', 'true');
		for (let index = 0; index < 24; index++) {
			const particle = document.createElement('span');
			particle.style.setProperty('--particle-x', `${Math.random() * 100}%`);
			particle.style.setProperty('--particle-delay', `${Math.random() * 300}ms`);
			particles.append(particle);
		}
		winnerBanner.append(particles);
		window.setTimeout(() => {
			document.body.classList.remove('screen-shake');
			particles.remove();
		}, 1500);
	}

	function renderPlayer(player, position) {
		const suffix = position === 1 ? 'one' : 'two';
		const days = getContributionDays(player);
		const stats = calculateStats(player);
		const fighterClass = assignFighterClass(player, stats);
		const profile = document.querySelector(`#profile-${suffix}`);
		profile.href = `https://github.com/${encodeURIComponent(player.username)}`;
		document.querySelector(`#avatar-${suffix}`).src =
			`https://github.com/${encodeURIComponent(player.username)}.png?size=96`;
		setText(`#player-${suffix}-title`, `@${player.username}`);
		setText(`#player-${suffix}-date`, `${player.from} — ${player.to}`);
		setText(`#fighter-${suffix}-class`, `${fighterClass.badge} ${fighterClass.name}`);
		document.querySelector(`#power-${suffix}`).setAttribute(
			'aria-label',
			`@${player.username} power`,
		);

		const grid = document.querySelector(`#grid-${suffix}`);
		grid.replaceChildren();
		for (const [weekIndex, week] of player.weeks.entries()) {
			const column = document.createElement('div');
			column.className = 'week-column';
			column.style.setProperty('--week-index', String(weekIndex));
			for (const day of week.days) {
				const cell = document.createElement('span');
				cell.className = 'contribution-day';
				cell.dataset.level = String(day.level);
				cell.title = `${day.date}: ${day.count} contribution${day.count === 1 ? '' : 's'}`;
				cell.setAttribute('role', 'img');
				cell.setAttribute('aria-label', cell.title);
				column.append(cell);
			}
			grid.append(column);
		}

		const statsList = document.querySelector(`#stats-${suffix}`);
		statsList.replaceChildren();
		const statValues = [
			['Total Contributions', formatNumber(stats.total)],
			['Longest Streak', `${stats.longestStreak} days`],
			['Current Streak', `${stats.currentStreak} days`],
			['Most Active Day', `${stats.peakDate} (${formatNumber(stats.peakCount)})`],
			['Consistency', `${stats.consistency}%`],
		];
		for (const [label, value] of statValues) {
			const term = document.createElement('dt');
			term.textContent = label;
			const description = document.createElement('dd');
			description.textContent = value;
			statsList.append(term, description);
		}

		return stats;
	}

	async function renderScoreboard(one, two, statsOne, statsTwo, version) {
		const battle = scoreBattle(statsOne, statsTwo);
		let scoreOne = 0;
		let scoreTwo = 0;
		const rows = document.querySelector('#score-rows');
		rows.replaceChildren();
		setText('#score-player-one', `@${one.username}`);
		setText('#score-player-two', `@${two.username}`);
		setText('#battle-score', 'Battle Score: 0 — 0 (5 points available)');
		setText('#winner-banner', '');

		for (const [index, result] of battle.rows.entries()) {
			if (index > 0) await delay(400);
			if (version !== requestVersion) return false;
			playHit();
			const row = document.createElement('tr');
			const category = document.createElement('th');
			category.scope = 'row';
			category.textContent = result.label;
			const oneCell = document.createElement('td');
			oneCell.textContent = result.label === 'Consistency'
				? `${result.valueOne}%`
				: formatNumber(result.valueOne);
			const pointsCell = document.createElement('td');
			const twoCell = document.createElement('td');
			twoCell.textContent = result.label === 'Consistency'
				? `${result.valueTwo}%`
				: formatNumber(result.valueTwo);

			if (result.winner === 1) {
				scoreOne++;
				oneCell.className = 'stat-winner';
			} else if (result.winner === 2) {
				scoreTwo++;
				twoCell.className = 'stat-winner';
			} else {
				scoreOne += 0.5;
				scoreTwo += 0.5;
				oneCell.className = 'stat-tie';
				twoCell.className = 'stat-tie';
			}

			pointsCell.textContent = result.points;
			row.append(category, oneCell, pointsCell, twoCell);
			row.classList.add('stat-reveal');
			rows.append(row);
			setPower(1, scoreOne);
			setPower(2, scoreTwo);
			setText('#battle-score', `Battle Score: ${scoreOne} — ${scoreTwo} (5 points available)`);
		}

		setText(
			'#winner-banner',
			battle.winner === 0
				? "IT'S A TIE!"
				: `${battle.winner === 1 ? `@${one.username}` : `@${two.username}`} WINS THE MATCH!`,
		);
		playVictory();
		triggerVictoryEffect();
		return true;
	}

	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		const usernames = [playerOneInput.value.trim(), playerTwoInput.value.trim()];
		if (usernames.some((name) => !isValidGitHubUsername(name))) {
			requestVersion++;
			battleButton.disabled = false;
			battleClash.hidden = true;
			powerBars.hidden = true;
			scoreboard.hidden = true;
			arena.hidden = true;
			errorMessage.textContent = 'Enter two valid GitHub usernames (letters, numbers, and single hyphens).';
			errorMessage.hidden = false;
			statusMessage.textContent = '';
			return;
		}

		const url = new URL(window.location.href);
		url.searchParams.set('p1', usernames[0]);
		url.searchParams.set('p2', usernames[1]);
		window.history.replaceState(null, '', url);

		const version = ++requestVersion;
		playCoin();
		playPowerUp();
		battleButton.disabled = true;
		scoreboard.hidden = true;
		arena.hidden = true;
		battleClash.hidden = false;
		powerBars.hidden = false;
		setText('#power-one-name', `@${usernames[0]}`);
		setText('#power-two-name', `@${usernames[1]}`);
		setPower(1, 0);
		setPower(2, 0);
		document.querySelector('#score-rows').replaceChildren();
		errorMessage.hidden = true;
		errorMessage.textContent = '';
		statusMessage.textContent = 'Loading both contribution calendars…';
		const countdown = runCountdown(version);

		try {
			const [one, two] = await Promise.all(usernames.map(getPlayer));
			if (version !== requestVersion) return;

			await countdown;
			if (version !== requestVersion) return;
			battleClash.hidden = true;
			battleClash.textContent = '';
			const statsOne = renderPlayer(one, 1);
			const statsTwo = renderPlayer(two, 2);
			arena.hidden = false;
			statusMessage.textContent = 'Contribution grids loading…';
			await delay(window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 900);
			if (version !== requestVersion) return;
			scoreboard.hidden = false;
			await renderScoreboard(one, two, statsOne, statsTwo, version);
			if (version !== requestVersion) return;
			statusMessage.textContent = 'Battle complete.';
		} catch (error) {
			if (version !== requestVersion) return;
			battleClash.hidden = true;
			powerBars.hidden = true;
			errorMessage.textContent = error instanceof Error ? error.message : 'The battle could not be loaded.';
			errorMessage.hidden = false;
			statusMessage.textContent = 'Battle could not be completed.';
		} finally {
			if (version === requestVersion) {
				battleButton.disabled = false;
				presetButtons.forEach((button) => { button.disabled = false; });
			}
		}
	});

	presetButtons.forEach((button) => {
		button.addEventListener('click', () => {
			playerOneInput.value = button.dataset.playerOne;
			playerTwoInput.value = button.dataset.playerTwo;
			form.requestSubmit();
		});
	});

	sfxToggle.addEventListener('click', () => {
		const enabled = !isSfxEnabled();
		setSfxEnabled(enabled);
		sfxToggle.textContent = enabled ? '🔊 SFX: ON' : '🔇 SFX: OFF';
		sfxToggle.setAttribute('aria-pressed', String(enabled));
		sfxToggle.setAttribute('aria-label', `Sound effects are ${enabled ? 'on' : 'off'}`);
		if (enabled) playCoin();
	});

	const sharedBattle = new URLSearchParams(window.location.search);
	const sharedPlayerOne = sharedBattle.get('p1');
	const sharedPlayerTwo = sharedBattle.get('p2');
	if (sharedPlayerOne && sharedPlayerTwo) {
		playerOneInput.value = sharedPlayerOne;
		playerTwoInput.value = sharedPlayerTwo;
		form.requestSubmit();
	}
</script>

<style>
	:root {
		font-family: 'JetBrains Mono', monospace;
		color: #f5f5ff;
		background: #0a0a12;
	}

	body {
		margin: 0;
		min-width: 320px;
		background:
			radial-gradient(ellipse at 50% 0%, #17172a 0%, #0a0a12 70%);
	}

	body::before,
	body::after {
		position: fixed;
		z-index: 10;
		inset: 0;
		pointer-events: none;
		content: '';
	}

	body::before {
		background: repeating-linear-gradient(
			to bottom,
			transparent 0,
			transparent 3px,
			rgba(0, 0, 0, 0.18) 4px
		);
	}

	body::after {
		background: radial-gradient(ellipse at center, transparent 48%, rgba(0, 0, 0, 0.62) 100%);
	}

	.page {
		position: relative;
		z-index: 1;
		width: min(100% - 32px, 1000px);
		margin: 0 auto;
		padding: 40px 0;
	}

	.page-header,
	.scoreboard {
		text-align: center;
	}

	.page-header {
		position: relative;
		display: grid;
		justify-items: center;
		margin-bottom: 32px;
		text-shadow: 0 0 12px #00f5ff88;
	}

	.page-header h1 {
		margin: 0;
		color: #7fffd4;
		font-family: 'Press Start 2P', monospace;
		font-size: clamp(1.25rem, 5vw, 2.4rem);
		line-height: 1.6;
		text-shadow: 0 0 8px #00f5ff, 0 0 24px #00f5ff88;
	}

	.page-header p,
	.player-card p {
		color: #b8b8d0;
	}

	.page-header > p {
		margin: 10px 0 0;
		font-size: 0.9rem;
	}

	.sfx-toggle {
		position: absolute;
		top: 0;
		right: 0;
		min-height: 34px;
		padding: 6px 10px;
		border-color: #42f5b0;
		background: #111321;
		color: #7fffd4;
		font-size: 0.7rem;
	}

	.battle-form {
		display: grid;
		grid-template-columns: 1fr auto 1fr auto;
		align-items: end;
		gap: 16px;
		padding: 20px;
		border: 1px solid #00e5ff88;
		border-radius: 4px;
		background: #10101b;
		box-shadow: 0 0 18px #00e5ff22, inset 0 0 18px #00e5ff0b;
	}

	.field {
		display: grid;
		gap: 8px;
	}

	.preset-matchups {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin-top: 12px;
		color: #9b9bb4;
		font-size: 0.75rem;
	}

	.preset-button {
		min-height: 32px;
		padding: 6px 10px;
		border: 1px solid #51456d;
		border-radius: 3px;
		background: #171322;
		color: #f5f5ff;
		font-size: 0.75rem;
	}

	.preset-button:hover,
	.preset-button:focus-visible {
		border-color: #ff4fd8;
		box-shadow: 0 0 12px #ff4fd888;
	}

	input,
	button {
		min-height: 42px;
		padding: 8px 12px;
		border: 1px solid #4a4967;
		border-radius: 3px;
		font: inherit;
	}

	input {
		color: #fff;
		background: #090a12;
	}

	input:focus-visible {
		border-color: #00e5ff;
		outline: 2px solid #00e5ff66;
		outline-offset: 2px;
		box-shadow: 0 0 14px #00e5ff55;
	}

	button {
		border-color: #00e5ff;
		border-radius: 3px;
		background: #00e5ff;
		color: #080a10;
		font-weight: 700;
		cursor: pointer;
		transition: filter 120ms ease, transform 120ms ease, box-shadow 120ms ease;
	}

	button:hover:not(:disabled) {
		filter: brightness(1.15);
		box-shadow: 0 0 16px #00e5ff88;
		transform: translateY(-1px);
	}

	button:focus-visible {
		outline: 3px solid #fff;
		outline-offset: 3px;
	}

	button:disabled {
		cursor: wait;
		opacity: 0.65;
	}

	.versus {
		padding-bottom: 12px;
		color: #ff4fd8;
		font-weight: 700;
	}

	.status,
	.scoreboard,
	.player-card {
		padding: 18px;
		border: 1px solid #38374d;
		border-radius: 4px;
		background: #10101b;
		box-shadow: 0 0 20px #0008;
	}

	.status,
	.scoreboard {
		margin-top: 20px;
	}

	.status {
		color: #b8b8d0;
		text-align: center;
	}

	.status p {
		margin: 0;
	}

	.scoreboard h2,
	.player-card h2,
	.player-card h3 {
		margin-top: 0;
	}

	.scoreboard h2,
	.player-card h2,
	.player-card h3,
	.score-table thead {
		font-family: 'Press Start 2P', monospace;
		font-size: 0.75rem;
		line-height: 1.8;
	}

	.arena {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px;
		margin-top: 20px;
	}

	.arena[hidden] {
		display: none;
	}

	.card-header {
		display: flex;
		align-items: center;
		gap: 12px;
